# Copy to .env and fill in. .env is read by both the backend (via config.yaml) and
# docker compose (variable interpolation in docker-compose.yml); it is never committed.
#
# Values here describe running the backend on the host. Inside docker compose the
# service addresses (MONGO_HOST, REDIS_URL, S3_RESOURCE_1_ENDPOINT_URL) and ROOT_PATH
# are overridden in docker-compose.yml, so they do not need a second copy.
#
# A variable set in the real environment beats the value in this file.

# ---------------------------------------------------------------------
# Local resource directories (host paths)
# Mounted as Local-resource/Resource-n; config.yaml and docker-compose.yml
# both read these, so a path is written only here.
# ---------------------------------------------------------------------
LOCAL_RESOURCE_1=/path/to/videos-1
LOCAL_RESOURCE_2=/path/to/videos-2
LOCAL_RESOURCE_3=/path/to/videos-3

# ---------------------------------------------------------------------
# MongoDB
# MONGO_DATABASE / MONGO_USERNAME / MONGO_PASSWORD also create the app user
# the first time the mongodb container initialises an empty data directory.
# ---------------------------------------------------------------------
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=video_tag_db
MONGO_USERNAME=exampleUser001
MONGO_PASSWORD=examplePassword

# ---------------------------------------------------------------------
# Redis cache
# ---------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# Server-side memory cap for the bundled redis container (LRU eviction at the cap).
REDIS_MAXMEMORY=256mb

# ---------------------------------------------------------------------
# S3 mount: S3-resource/Resource-1
# ---------------------------------------------------------------------
S3_RESOURCE_1_ENDPOINT_URL=http://localhost:9000
S3_RESOURCE_1_ACCESS_KEY=rustfsadmin
S3_RESOURCE_1_SECRET_KEY=rustfsadmin
S3_RESOURCE_1_BUCKET=video-app
S3_RESOURCE_1_REGION=us-east-1

# ---------------------------------------------------------------------
# Bundled rustfs container (S3-compatible storage)
# When Resource-1 points at it, its keys must match S3_RESOURCE_1_*_KEY.
# ---------------------------------------------------------------------
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
