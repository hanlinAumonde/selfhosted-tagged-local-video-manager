# Environment for the e2e stack (docker-compose.e2e.yml). Committed on purpose: every
# value is a throwaway that only lives inside the e2e containers.
#
# Passed twice: `--env-file` for compose's own ${...} interpolation, and `env_file` for
# what the containers read, which is what docker-compose.yml's `.env` does for dev.

# Never mounted (the e2e stack mounts a seeded volume instead); set only because
# docker-compose.yml refuses to start without them.
LOCAL_RESOURCE_1=/unused
LOCAL_RESOURCE_2=/unused
LOCAL_RESOURCE_3=/unused

MONGO_DATABASE=video_tag_e2e
MONGO_USERNAME=e2e
MONGO_PASSWORD=e2e-password

REDIS_MAXMEMORY=128mb

S3_RESOURCE_1_ACCESS_KEY=e2e-access
S3_RESOURCE_1_SECRET_KEY=e2e-secret-key
S3_RESOURCE_1_BUCKET=video-app
S3_RESOURCE_1_REGION=us-east-1

RUSTFS_ACCESS_KEY=e2e-access
RUSTFS_SECRET_KEY=e2e-secret-key

# The image every backend process and the seed run; CI sets it to the tag it built.
BACKEND_IMAGE=video-app-backend:e2e
FRONTEND_IMAGE=video-app-frontend:e2e
E2E_PORT=8080
